{
  "name": "client-react",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "dev:shared": "cd packages/shared-react && npm run dev",
    "build": "npm run build:shared && next build --turbopack",
    "build:shared": "cd packages/shared-react && npm run build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.1.0",
    "@tanstack/react-query": "^5.0.0",
    "antd": "^5.27.6",
    "axios": "^1.6.0",
    "clsx": "^2.0.0",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
